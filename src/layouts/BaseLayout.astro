---
interface Props {
  title: string;
  description?: string;
  pageSlug?: string;
}

const { title, description = 'Интерактивный курс по разработке Obby в Roblox Studio', pageSlug = '' } = Astro.props;
const homeUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const planUrl = `${homeUrl}plan/`;
const isHome = pageSlug === '';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${homeUrl}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body data-page-slug={pageSlug}>
    <header class="site-header">
      <div class="container header-inner">
        <a class="home-link" href={homeUrl}>🎮 Roblox Obby</a>
        <nav class="site-nav">
          <a href={homeUrl} aria-current={isHome ? 'page' : undefined}>Главная</a>
          <a href={planUrl} aria-current={pageSlug === 'roblox-learning-plan' ? 'page' : undefined}>Полный план</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<script>
  import { isEnabled, toggle, subscribe } from '../lib/progress';

  const slug = document.body.dataset.pageSlug ?? '';

  const checkboxes = document.querySelectorAll<HTMLInputElement>(
    'li.task-list-item > input[type="checkbox"]'
  );

  const progressWrap = document.querySelector<HTMLElement>('.progress-wrap[data-total]');

  function refreshProgress(): void {
    if (!progressWrap) return;
    const total = Number(progressWrap.dataset.total ?? 0);
    let done = 0;
    checkboxes.forEach((checkbox) => {
      if (checkbox.checked) done++;
    });
    const label = progressWrap.querySelector<HTMLElement>('.progress-label');
    const fill = progressWrap.querySelector<HTMLElement>('.progress-fill');
    if (label) label.textContent = `${done}/${total} шагов`;
    if (fill) fill.style.width = total ? `${Math.round((done / total) * 100)}%` : '0%';
  }

  checkboxes.forEach((checkbox, i) => {
    const stepId = `${slug}:step-${i + 1}`;
    checkbox.disabled = false;
    checkbox.dataset.stepId = stepId;
    checkbox.checked = isEnabled(stepId);
    checkbox.addEventListener('change', () => {
      toggle(stepId);
    });
  });

  subscribe(refreshProgress);
  refreshProgress();
</script>

<style is:global>
  /* Палитра Solarized Light */
  :root {
    --bg: #fdf6e3; /* base3 */
    --bg-soft: #eee8d5; /* base2 */
    --border: #ddd6c1;
    --text: #586e75; /* base01 */
    --heading: #073642; /* base02 */
    --muted: #93a1a1; /* base1 */
    --accent: #268bd2; /* blue */
    --green: #859900; /* green */
    --cyan: #2aa198; /* cyan */
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-size: 17px;
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.65;
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--heading);
    line-height: 1.25;
  }

  h1 {
    font-weight: 800;
  }

  h2 {
    font-weight: 700;
    margin-top: 40px;
  }

  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .header-inner {
    padding-top: 14px;
    padding-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .home-link {
    font-weight: 700;
    text-decoration: none;
    color: var(--heading);
  }

  .site-nav {
    display: flex;
    gap: 20px;
  }

  .site-nav a {
    text-decoration: none;
    font-weight: 500;
    color: var(--text);
  }

  .site-nav a:hover {
    color: var(--cyan);
  }

  .site-nav a[aria-current='page'] {
    color: var(--accent);
    font-weight: 700;
  }

  main.container {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  article {
    min-width: 0;
  }

  h1,
  h2 {
    scroll-margin-top: 16px;
  }

  a {
    color: var(--accent);
  }

  a:hover {
    color: var(--cyan);
  }

  blockquote {
    margin: 0;
    padding: 4px 16px;
    border-left: 4px solid var(--muted);
    color: var(--muted);
  }

  table {
    border-collapse: collapse;
    width: 100%;
    margin: 16px 0;
    display: block;
    overflow-x: auto;
  }

  th,
  td {
    border: 1px solid var(--border);
    padding: 6px 12px;
    text-align: left;
  }

  th {
    background: var(--bg-soft);
    color: var(--heading);
  }

  pre {
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    line-height: 1.45;
  }

  code:not(pre code) {
    background: var(--bg-soft);
    color: var(--heading);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  /* Чекбоксы шагов */
  li:has(> input[type='checkbox']) {
    list-style: none;
    margin-left: -22px;
  }

  li:has(> input[type='checkbox']) > input[type='checkbox'] {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    vertical-align: middle;
    accent-color: var(--green);
  }

  li:has(> input[type='checkbox']:checked) {
    color: var(--muted);
  }

  li:has(> input[type='checkbox']:checked) > label:has(+ *) ,
  li:has(> input[type='checkbox']:checked)::marker {
    opacity: 0.55;
  }

  /* Прогресс */
  .progress-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 12px 0 28px;
  }

  .progress-track {
    flex: 1;
    height: 8px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: var(--green);
    transition: width 0.25s ease;
  }

  .progress-label {
    white-space: nowrap;
    font-size: 0.9em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Список фаз на главной */
  .phase-grid {
    list-style: none;
    padding: 0;
    margin: 16px 0 32px;
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .phase-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .phase-card {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .phase-card:hover {
    background: var(--bg-soft);
    border-color: var(--cyan);
  }

  .phase-card .progress-label {
    flex-shrink: 0;
  }

  /* Состояния карточек фаз */
  .phase-card.in-progress {
    border-color: var(--accent);
  }

  .phase-card.done {
    border-color: var(--green);
  }

  /* Prev / next */
  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .prev-next a {
    max-width: 48%;
  }

  .prev-next .next-link {
    margin-left: auto;
    text-align: right;
  }
</style>
